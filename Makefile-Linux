# Makefile-Linux - liboncrpc for Linux (GNU make)
#
#   make -f Makefile-Linux             build the library, oncrpcgen and the examples
#   make -f Makefile-Linux debug       the same with AddressSanitizer and UBSan, in
#                                      build/linux/debug
#   make -f Makefile-Linux lib         build only the libraries: liboncrpc.a and
#                                      liboncrpc.so
#   make -f Makefile-Linux check       build and run the tests and the examples
#                                      ('make -f Makefile-Linux debug check' runs them
#                                      under the sanitizers)
#   make -f Makefile-Linux install     install oncrpcgen, the library and headers under
#                                      $(PREFIX)
#   make -f Makefile-Linux uninstall   remove what 'install' installed
#   make -f Makefile-Linux clean       remove the Linux build output (build/linux);
#                                      Windows, FreeBSD or macOS builds elsewhere in
#                                      build/ are left alone
#
# Needs libuv and OpenSSL 3 (with pkg-config):
#   apt install build-essential pkg-config libuv1-dev libssl-dev   (Debian/Ubuntu)
#
# Variables you can override:  make -f Makefile-Linux CC=clang PREFIX=$HOME/.local V=1
#
# For FreeBSD use Makefile-FreeBSD, with the system's make; for macOS,
# Makefile-macOS.

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

CC         ?= cc
PKG_CONFIG ?= pkg-config
NM         ?= nm
PREFIX     ?= /usr/local
DESTDIR    ?=

BINDIR     := $(PREFIX)/bin
LIBDIR     := $(PREFIX)/lib
INCLUDEDIR := $(PREFIX)/include/oncrpc

PROGRAM    := oncrpcgen
LIBRARY    := liboncrpc.a

# The shared library is named after the version in src/oncrpc.h:
# liboncrpc.so.4.3.0, with the soname liboncrpc.so.4 (the major version,
# which changes when programs must be rebuilt) and liboncrpc.so for linking.
VERSION      := $(shell sed -n 's/.*ONCRPC_VERSION_STRING *"\([0-9.]*\)".*/\1/p' src/oncrpc.h)
MAJOR        := $(firstword $(subst ., ,$(VERSION)))
SHLIB        := liboncrpc.so.$(VERSION)
SHLIB_SONAME := liboncrpc.so.$(MAJOR)
SHLIB_LINK   := liboncrpc.so
# Fail the link if the library needs anything it does not name (not under
# the sanitizers, whose run-time is supplied by the program).
SHLIB_LDFLAGS := -Wl,--no-undefined

SRCDIR      := src

LIB_SOURCES := xdr.c auth.c error.c client.c pmap.c server.c tls.c xparse.c xgen.c
APP_SOURCES := oncrpcgen.c
HEADERS     := oncrpc.h xdr.h xspec.h
ALL_HEADERS := $(HEADERS) internal.h

# The client/server examples, as directory:name-of-the-.x-file. 08_xdr (XDR
# only, no networking) is built separately below.
RPC_EXAMPLES := 01_add:add 02_strings:greet 03_shapes:shapes 04_lists:lists \
                05_async:delay 06_portmap:clock 07_errors:secure \
                09_local:local 10_tls:hello 11_auth:token

PKGS := libuv openssl

# Fail early with a clear message if a dependency is missing.
ifeq ($(filter clean uninstall,$(MAKECMDGOALS)),)
  ifneq ($(shell $(PKG_CONFIG) --exists $(PKGS) && echo yes),yes)
    $(error Missing development packages. On Debian/Ubuntu: \
            apt install libuv1-dev libssl-dev pkg-config)
  endif
  PKG_CFLAGS := $(shell $(PKG_CONFIG) --cflags $(PKGS))
  PKG_LIBS   := $(shell $(PKG_CONFIG) --libs $(PKGS))
endif

# _POSIX_C_SOURCE is needed for <uv.h> under strict -std=c99.
CPPFLAGS += -D_POSIX_C_SOURCE=200809L -I$(SRCDIR)
CFLAGS   ?= -O2 -g
CFLAGS   += -std=c99 -Wall -Wextra -Wpedantic -Wshadow -Wconversion
CFLAGS   += -MMD -MP $(PKG_CFLAGS)
LDLIBS   += $(PKG_LIBS)

# Sources are in src/. Linux output goes under build/linux (release builds in
# build/linux/release, debug builds in build/linux/debug), so that it does not
# mix with a Visual Studio build (build/x64, build/obj) or a FreeBSD or macOS
# build (build/freebsd, build/macos).
BUILDROOT := build/linux
BUILD := $(BUILDROOT)/release
ifneq ($(filter debug,$(MAKECMDGOALS)),)
  BUILD   := $(BUILDROOT)/debug
  CFLAGS  += -O1 -fno-omit-frame-pointer -fsanitize=address,undefined
  LDFLAGS += -fsanitize=address,undefined
  SHLIB_LDFLAGS :=
endif

OBJDIR      := $(BUILD)/obj
EXDIR       := $(BUILD)/examples
TESTDIR     := $(BUILD)/tests
LIB_OBJECTS := $(LIB_SOURCES:%.c=$(OBJDIR)/%.o)
APP_OBJECTS := $(APP_SOURCES:%.c=$(OBJDIR)/%.o)

example_dir  = $(word 1,$(subst :, ,$(1)))
example_name = $(word 2,$(subst :, ,$(1)))
EXAMPLE_PROGRAMS := $(foreach e,$(RPC_EXAMPLES),\
                      $(EXDIR)/$(call example_dir,$(e))/server \
                      $(EXDIR)/$(call example_dir,$(e))/client) \
                    $(EXDIR)/08_xdr/xdr_demo
TEST_PROGRAMS := $(TESTDIR)/test_xdr $(TESTDIR)/test_xspec $(TESTDIR)/test_rpcb $(TESTDIR)/test_gen \
                 $(TESTDIR)/test_rpc $(TESTDIR)/test_rpc_shared $(TESTDIR)/test_tls \
                 $(TESTDIR)/test_soak

# Quiet output; 'make V=1' shows full commands.
ifeq ($(V),1)
  Q :=
  say :=
else
  Q := @
  say = @printf '  %-6s %s\n' $(1) $(2);
endif

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------

.PHONY: all debug lib examples check check-alloc check-exports soak install uninstall clean

all: $(BUILD)/$(PROGRAM) $(BUILD)/$(LIBRARY) $(BUILD)/$(SHLIB) $(EXAMPLE_PROGRAMS)
	$(Q)ln -sf $(BUILD)/$(PROGRAM) $(PROGRAM)

debug: $(BUILD)/$(PROGRAM) $(BUILD)/$(LIBRARY) $(BUILD)/$(SHLIB) $(EXAMPLE_PROGRAMS)
	@echo "Debug build: $(BUILD)"

lib: $(BUILD)/$(LIBRARY) $(BUILD)/$(SHLIB)

examples: $(EXAMPLE_PROGRAMS)

# The library and the code generator

# One set of objects serves both libraries: position-independent, and with
# only the functions marked ONCRPC_API visible outside the shared library.
$(LIB_OBJECTS): CFLAGS += -fPIC -fvisibility=hidden

$(BUILD)/$(LIBRARY): $(LIB_OBJECTS)
	$(call say,AR,$@)
	$(Q)rm -f $@
	$(Q)$(AR) rcs $@ $^

$(BUILD)/$(SHLIB): $(LIB_OBJECTS)
	$(call say,LINK,$@)
	$(Q)$(CC) $(LDFLAGS) -shared -Wl,-soname,$(SHLIB_SONAME) $(SHLIB_LDFLAGS) -o $@ \
	    $(LIB_OBJECTS) $(LDLIBS)
	$(Q)ln -sf $(SHLIB) $(BUILD)/$(SHLIB_SONAME)
	$(Q)ln -sf $(SHLIB_SONAME) $(BUILD)/$(SHLIB_LINK)

# oncrpcgen uses only the XDR, parser and generator parts: no libuv.
$(BUILD)/$(PROGRAM): $(APP_OBJECTS) $(BUILD)/$(LIBRARY)
	$(call say,LINK,$@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $(APP_OBJECTS) $(BUILD)/$(LIBRARY)

$(OBJDIR)/%.o: $(SRCDIR)/%.c | $(OBJDIR)
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

$(OBJDIR):
	$(Q)mkdir -p $@

# ---------------------------------------------------------------------------
# Examples: examples/<dir>/<name>.x is compiled by oncrpcgen into
# build/linux/<release|debug>/examples/<dir>/, where server.c and client.c are
# built against the generated code.
# ---------------------------------------------------------------------------

# $(1) = example directory, $(2) = name of its .x file
define RPC_EXAMPLE
$(EXDIR)/$(1)/.generated: examples/$(1)/$(2).x $(BUILD)/$(PROGRAM)
	$$(call say,GEN,examples/$(1)/$(2).x)
	$(Q)mkdir -p $(EXDIR)/$(1)
	$(Q)$(BUILD)/$(PROGRAM) -o $(EXDIR)/$(1) examples/$(1)/$(2).x
	$(Q)touch $$@

$(EXDIR)/$(1)/$(2).h $(EXDIR)/$(1)/$(2)_xdr.c $(EXDIR)/$(1)/$(2)_clnt.c \
$(EXDIR)/$(1)/$(2)_svc.c: $(EXDIR)/$(1)/.generated ;

$(EXDIR)/$(1)/%.o: $(EXDIR)/$(1)/%.c
	$$(call say,CC,$$<)
	$(Q)$(CC) $(CPPFLAGS) -I$(EXDIR)/$(1) $(CFLAGS) -c -o $$@ $$<

$(EXDIR)/$(1)/%.o: examples/$(1)/%.c $(EXDIR)/$(1)/.generated
	$$(call say,CC,$$<)
	$(Q)$(CC) $(CPPFLAGS) -I$(EXDIR)/$(1) $(CFLAGS) -c -o $$@ $$<

$(EXDIR)/$(1)/server: $(EXDIR)/$(1)/server.o $(EXDIR)/$(1)/$(2)_xdr.o \
                      $(EXDIR)/$(1)/$(2)_svc.o $(BUILD)/$(LIBRARY)
	$$(call say,LINK,$$@)
	$(Q)$(CC) $(LDFLAGS) -o $$@ $$(filter %.o,$$^) $(BUILD)/$(LIBRARY) $(LDLIBS) -lm

$(EXDIR)/$(1)/client: $(EXDIR)/$(1)/client.o $(EXDIR)/$(1)/$(2)_xdr.o \
                      $(EXDIR)/$(1)/$(2)_clnt.o $(BUILD)/$(LIBRARY)
	$$(call say,LINK,$$@)
	$(Q)$(CC) $(LDFLAGS) -o $$@ $$(filter %.o,$$^) $(BUILD)/$(LIBRARY) $(LDLIBS) -lm
endef

$(foreach e,$(RPC_EXAMPLES),\
  $(eval $(call RPC_EXAMPLE,$(call example_dir,$(e)),$(call example_name,$(e)))))

# 08_xdr has no program: only the header and XDR routines, and no libuv.
$(EXDIR)/08_xdr/.generated: examples/08_xdr/readings.x $(BUILD)/$(PROGRAM)
	$(call say,GEN,examples/08_xdr/readings.x)
	$(Q)mkdir -p $(EXDIR)/08_xdr
	$(Q)$(BUILD)/$(PROGRAM) -h -c -o $(EXDIR)/08_xdr examples/08_xdr/readings.x
	$(Q)touch $@

$(EXDIR)/08_xdr/readings.h $(EXDIR)/08_xdr/readings_xdr.c: $(EXDIR)/08_xdr/.generated ;

$(EXDIR)/08_xdr/readings_xdr.o: $(EXDIR)/08_xdr/readings_xdr.c
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) -I$(EXDIR)/08_xdr $(CFLAGS) -c -o $@ $<

$(EXDIR)/08_xdr/main.o: examples/08_xdr/main.c $(EXDIR)/08_xdr/.generated
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) -I$(EXDIR)/08_xdr $(CFLAGS) -c -o $@ $<

$(EXDIR)/08_xdr/xdr_demo: $(EXDIR)/08_xdr/main.o $(EXDIR)/08_xdr/readings_xdr.o $(BUILD)/$(LIBRARY)
	$(call say,LINK,$@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $(filter %.o,$^) $(BUILD)/$(LIBRARY)

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

$(TESTDIR):
	$(Q)mkdir -p $@

$(TESTDIR)/%.o: tests/%.c | $(TESTDIR)
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

$(TESTDIR)/test_xdr: $(TESTDIR)/test_xdr.o $(BUILD)/$(LIBRARY)
	$(call say,LINK,$@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $< $(BUILD)/$(LIBRARY) $(LDLIBS)

$(TESTDIR)/test_xspec: $(TESTDIR)/test_xspec.o $(BUILD)/$(LIBRARY)
	$(call say,LINK,$@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $< $(BUILD)/$(LIBRARY) $(LDLIBS)

# test_rpcb talks to rpcbind on 127.0.0.1:111 when one is running.
$(TESTDIR)/test_rpcb: $(TESTDIR)/test_rpcb.o $(BUILD)/$(LIBRARY)
	$(call say,LINK,$@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $< $(BUILD)/$(LIBRARY) $(LDLIBS)

# test_gen round-trips every declaration form through generated code. The
# generated client, server and both skeletons are also built, with -Werror.
$(TESTDIR)/alltypes/.generated: tests/alltypes.x $(BUILD)/$(PROGRAM)
	$(call say,GEN,tests/alltypes.x)
	$(Q)mkdir -p $(TESTDIR)/alltypes
	$(Q)$(BUILD)/$(PROGRAM) -a -S -C -f -o $(TESTDIR)/alltypes tests/alltypes.x
	$(Q)touch $@

$(addprefix $(TESTDIR)/alltypes/alltypes,.h _xdr.c _clnt.c _svc.c _server_skel.c _client_skel.c): \
    $(TESTDIR)/alltypes/.generated ;

$(TESTDIR)/alltypes/%.o: $(TESTDIR)/alltypes/%.c
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -c -o $@ $<

ALLTYPES := $(TESTDIR)/alltypes/alltypes
$(TESTDIR)/test_gen: tests/test_gen.c $(ALLTYPES)_xdr.o $(ALLTYPES)_clnt.o $(ALLTYPES)_svc.o \
                     $(ALLTYPES)_server_skel.o $(ALLTYPES)_client_skel.o $(BUILD)/$(LIBRARY)
	$(call say,LINK,$(ALLTYPES)_server)
	$(Q)$(CC) $(LDFLAGS) -o $(ALLTYPES)_server $(ALLTYPES)_server_skel.o $(ALLTYPES)_svc.o \
	    $(ALLTYPES)_xdr.o $(BUILD)/$(LIBRARY) $(LDLIBS)
	$(call say,LINK,$(ALLTYPES)_client)
	$(Q)$(CC) $(LDFLAGS) -o $(ALLTYPES)_client $(ALLTYPES)_client_skel.o $(ALLTYPES)_clnt.o \
	    $(ALLTYPES)_xdr.o $(BUILD)/$(LIBRARY) $(LDLIBS)
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) -I$(TESTDIR)/alltypes $(CFLAGS) -Werror $(LDFLAGS) -o $@ $< \
	    $(ALLTYPES)_xdr.o $(BUILD)/$(LIBRARY) $(LDLIBS)

# test_rpc runs a client and a server in one loop, using tests/calc.x.
$(TESTDIR)/calc/.generated: tests/calc.x $(BUILD)/$(PROGRAM)
	$(call say,GEN,tests/calc.x)
	$(Q)mkdir -p $(TESTDIR)/calc
	$(Q)$(BUILD)/$(PROGRAM) -o $(TESTDIR)/calc tests/calc.x
	$(Q)touch $@

$(addprefix $(TESTDIR)/calc/calc,.h _xdr.c _clnt.c _svc.c): $(TESTDIR)/calc/.generated ;

$(TESTDIR)/calc/%.o: $(TESTDIR)/calc/%.c
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

$(TESTDIR)/test_rpc: tests/test_rpc.c $(TESTDIR)/calc/calc_xdr.o $(TESTDIR)/calc/calc_clnt.o \
                     $(TESTDIR)/calc/calc_svc.o $(BUILD)/$(LIBRARY)
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) -I$(TESTDIR)/calc $(CFLAGS) $(LDFLAGS) -o $@ $< \
	    $(filter %.o,$^) $(BUILD)/$(LIBRARY) $(LDLIBS)

# test_rpc_shared: test_rpc again, linked with the shared library (found
# next to it through the rpath, without installing it).
$(TESTDIR)/test_rpc_shared: tests/test_rpc.c $(TESTDIR)/calc/calc_xdr.o $(TESTDIR)/calc/calc_clnt.o \
                            $(TESTDIR)/calc/calc_svc.o $(BUILD)/$(SHLIB)
	$(call say,CC,$@)
	$(Q)$(CC) $(CPPFLAGS) -I$(TESTDIR)/calc $(CFLAGS) $(LDFLAGS) -o $@ $< \
	    $(filter %.o,$^) -L$(BUILD) -loncrpc -Wl,-rpath,'$$ORIGIN/..' $(LDLIBS)

# test_tls: RPC-with-TLS, with the certificates in tests/tls_certs.h.
$(TESTDIR)/test_tls: tests/test_tls.c tests/tls_certs.h $(TESTDIR)/calc/calc_xdr.o \
                     $(TESTDIR)/calc/calc_clnt.o $(TESTDIR)/calc/calc_svc.o $(BUILD)/$(LIBRARY)
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) -I$(TESTDIR)/calc $(CFLAGS) $(LDFLAGS) -o $@ $< \
	    $(filter %.o,$^) $(BUILD)/$(LIBRARY) $(LDLIBS)

# test_soak: many clients, a lossy UDP relay and small server limits.
$(TESTDIR)/test_soak: tests/test_soak.c $(TESTDIR)/calc/calc_xdr.o $(TESTDIR)/calc/calc_clnt.o \
                      $(TESTDIR)/calc/calc_svc.o $(BUILD)/$(LIBRARY)
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) -I$(TESTDIR)/calc $(CFLAGS) $(LDFLAGS) -o $@ $< \
	    $(filter %.o,$^) $(BUILD)/$(LIBRARY) $(LDLIBS)

# The library must never call the C allocator: check what its objects import.
check-alloc: $(LIB_OBJECTS)
	$(Q)if $(NM) -u $(LIB_OBJECTS) | grep -Ew '_?(malloc|calloc|realloc|free|strdup|strndup|aligned_alloc|posix_memalign)$$'; then \
	    echo "check-alloc: FAILED - the library references the C allocator"; exit 1; \
	else echo "check-alloc: the library does not reference malloc/calloc/realloc/free"; fi

# The shared library must export exactly the functions marked ONCRPC_API.
check-exports: $(BUILD)/$(SHLIB)
	$(Q)sh tests/check_exports.sh elf $(BUILD)/$(SHLIB) $(NM)

check: $(TEST_PROGRAMS) $(EXAMPLE_PROGRAMS) check-alloc check-exports
	$(Q)$(TESTDIR)/test_xdr
	$(Q)$(TESTDIR)/test_xspec
	$(Q)$(TESTDIR)/test_gen
	$(Q)$(TESTDIR)/test_rpc
	$(Q)echo "test_rpc_shared (test_rpc with $(SHLIB_SONAME)):"
	$(Q)$(TESTDIR)/test_rpc_shared
	$(Q)$(TESTDIR)/test_rpcb
	$(Q)$(TESTDIR)/test_tls
	$(Q)sh tests/run_examples.sh $(EXDIR)

# A longer run under a lossy network: 'make soak SEED=7 SCALE=10'.
SEED  ?= 1
SCALE ?= 1
soak: $(TESTDIR)/test_soak
	$(Q)$(TESTDIR)/test_soak $(SEED) $(SCALE)

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

install: all
	install -d $(DESTDIR)$(BINDIR) $(DESTDIR)$(LIBDIR) $(DESTDIR)$(INCLUDEDIR)
	install -m 755 $(BUILD)/$(PROGRAM) $(DESTDIR)$(BINDIR)/$(PROGRAM)
	install -m 644 $(BUILD)/$(LIBRARY) $(DESTDIR)$(LIBDIR)/$(LIBRARY)
	install -m 755 $(BUILD)/$(SHLIB) $(DESTDIR)$(LIBDIR)/$(SHLIB)
	ln -sf $(SHLIB) $(DESTDIR)$(LIBDIR)/$(SHLIB_SONAME)
	ln -sf $(SHLIB_SONAME) $(DESTDIR)$(LIBDIR)/$(SHLIB_LINK)
	install -m 644 $(addprefix $(SRCDIR)/,$(HEADERS)) $(DESTDIR)$(INCLUDEDIR)/
	@echo "Installed $(SHLIB) in $(LIBDIR); run ldconfig if that is a system directory."

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/$(PROGRAM)
	rm -f $(DESTDIR)$(LIBDIR)/$(LIBRARY)
	rm -f $(DESTDIR)$(LIBDIR)/$(SHLIB) $(DESTDIR)$(LIBDIR)/$(SHLIB_SONAME) $(DESTDIR)$(LIBDIR)/$(SHLIB_LINK)
	rm -f $(addprefix $(DESTDIR)$(INCLUDEDIR)/,$(HEADERS))
	-rmdir $(DESTDIR)$(INCLUDEDIR) 2>/dev/null

clean:
	rm -rf $(BUILDROOT)
	@if [ -L $(PROGRAM) ]; then rm -f $(PROGRAM); fi
	@rmdir build 2>/dev/null || true

# Header dependencies generated by -MMD.
-include $(shell find $(BUILD) -name '*.d' 2>/dev/null)
